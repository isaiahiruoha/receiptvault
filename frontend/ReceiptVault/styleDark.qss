/* Main Window */
QMainWindow {
    background-color: #121212;
    color: #E0E0E0;
}

/* Buttons */
QPushButton {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #3E3E3E;
    border-radius: 15px;
    font: bold 15px;
    padding: 10px 20px;
}

QPushButton:hover {
    background-color: #333333;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #0088FF;
    color: #FFFFFF;
}

/* Labels */
QLabel {
    color: #E0E0E0;
    font: bold 14px "Arial";
}

QLabel#titleLabel {
    color: #E0E0E0;
    font: bold 35px "Palatino Linotype";
    text-align: center;
}

QLabel#appTitle {
    font-size: 56px;
    font-weight: bold;
    color: #E0E0E0;
    text-align: center;
    border: none;
}

QLabel#label_AnalyticsTitle {
    color: #E0E0E0;
    font: bold 35px "Palatino Linotype";
    padding: 10px;
    text-align: center;
}

QLabel#label_BudgetsTitle {
    color: #E0E0E0;
    font: bold 35px "Palatino Linotype";
    padding: 10px;
}

QLabel#label_CreateAccount {
    color: #E0E0E0;
    font: bold 35px "Palatino Linotype";
    text-align: center;
}

QLabel#label_ReceiptsTitle {
    color: #E0E0E0;
    font: bold 35px "Palatino Linotype";
    padding: 10px;
}

QLabel#label_TopCategory, QLabel#label_TotalSpending, QLabel#label_TotalReceipts, QLabel#label_AvgMonthlySpending {
   border: 2px solid rgb(200, 200, 200);
   border-radius: 15px;
}


/* Line Edits */
QLineEdit {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border: none;
    border-bottom: 3px solid #3E3E3E;
    font: bold 16px "Arial";
    padding: 5px;
}

QLineEdit:focus {
    border-bottom: 3px solid #0088FF;
}

/* Checkboxes */
QCheckBox {
    spacing: 5px;
    font-size: 14px;
    color: #E0E0E0;
    padding: 2px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #666666;
    background-color: #444444;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    border: 1px solid #0088FF;
    background-color: #0088FF;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #888888;
    background-color: #555555;
}

QCheckBox::indicator:checked:hover {
    border: 1px solid #0077CC;
    background-color: #0077CC;
}

/* Table Widgets */

QTableWidget {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #3E3E3E;
    border-radius: 10px;
    gridline-color: #444444;
    font: 14px "Arial";
}

QHeaderView::section {
    background-color: #0F0F0F;
    color: white;
    font: bold 14px "Arial";
    padding: 4px;
    border: 1px solid #373737;
}

QTableWidget::item {
    background-color: #1E1E1E;
    color: #E0E0E0;
}

QTableWidget::item:selected {
    background-color: #333333;
    color: #FFFFFF;
}

/* Combo Boxes */
QComboBox {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #3E3E3E;
    padding: 5px;
    border-radius: 5px;
}

QComboBox::drop-down {
    border: none;
    background-color: #333333;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    color: #E0E0E0;
    selection-background-color: #333333;
    selection-color: #FFFFFF;
    border: 1px solid #3E3E3E;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #3E3E3E;
    background-color: #1E1E1E;
}

QTabBar::tab {
    background-color: #1E1E1E;
    color: #E0E0E0;
    padding: 10px;
    border: 1px solid #3E3E3E;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #333333;
    color: #FFFFFF;
    border: 1px solid #0088FF;
}

QTabBar::tab:hover {
    background-color: #444444;
    color: #FFFFFF;
}

/* Scrollbars */
QScrollBar:vertical, QScrollBar:horizontal {
    background-color: #1E1E1E;
    border: none;
    width: 8px;
    height: 8px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #444444;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #666666;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background-color: #333333;
    border: none;
    width: 0px;
    height: 0px;
}

#CategoryManagerDialog {
    background-color: #1E1E1E;
    border: 2px solid #3E3E3E;
    border-radius: 10px;
    color: #FFFFFF;
    font: 14px "Arial";
}

#CategoryManagerDialog QLabel {
    color: #E0E0E0;
    font: bold 16px "Arial";
}

#CategoryManagerDialog QLineEdit {
    background-color: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
    padding: 5px;
    border-radius: 5px;
}

#CategoryManagerDialog QLineEdit:focus {
    border: 1px solid #0088FF;
}

#CategoryManagerDialog QPushButton {
    background-color: #333333;
    color: #FFFFFF;
    border: 1px solid #3E3E3E;
    border-radius: 5px;
    font: bold 12px "Arial";
    padding: 5px 15px;
}

#CategoryManagerDialog QPushButton:hover {
    background-color: #444444;
}

#CategoryManagerDialog QPushButton:pressed {
    background-color: #555555;
}

